		},
		{
			"id": "R6P7wiVB",
			"type": "text",
			"x": 40.337,
			"y": 419.595,
			"width": 555,
			"height": 522.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bAQ",
			"roundness": null,
			"seed": 602841828,
			"version": 474,
			"versionNonce": 463093860,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794751592171,
			"created": 1794735184333,
			"link": null,
			"locked": false,
			"text": "FR:\n1) Buy subscription (initiate payment)\n2) Auto Renew subscription\n3) Cancel subscription / stop renewal\n4) Voucher for subscription\n5) Check subscription status\n\nNFR:\n1) 99.99% Availability\n2) Strong consistency for payment/entitlement\n3) <100ms status, <200ms buy init (p95)\n   (PSP payment is async, not included)\n4) Durable state and reliable events\n5) No duplicate charge / subscription period\n\nCore Entities:\nPlans\nSubscriptions\nInvoices (Billings)\nPayment Attempts\nVouchers\nOutbox / Webhook Inbox",
			"fontSize": 19,
			"baseFontSize": 19,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "FR:\n1) Buy subscription (initiate payment)\n2) Auto Renew subscription\n3) Cancel subscription / stop renewal\n4) Voucher for subscription\n5) Check subscription status\n\nNFR:\n1) 99.99% Availability\n2) Strong consistency for payment/entitlement\n3) <100ms status, <200ms buy init (p95)\n   (PSP payment is async, not included)\n4) Durable state and reliable events\n5) No duplicate charge / subscription period\n\nCore Entities:\nPlans\nSubscriptions\nInvoices (Billings)\nPayment Attempts\nVouchers\nOutbox / Webhook Inbox",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "sKB6DGh7",
			"type": "text",
			"x": 666.636,
			"y": 403.093,
			"width": 445,
			"height": 450,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bAR",
			"roundness": null,
			"seed": 1858343396,
			"version": 399,
			"versionNonce": 640979420,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794735659305,
			"created": 1794735436344,
			"link": null,
			"locked": false,
			"text": "API Design\nREST\nPOST /api/v1/subscription/subscribe\nHeader: Bearer JWT\nIdempotency-Key: <unique key>\nBody: { planId, voucherCode? }\n=> 202 {subscriptionId, paymentId,\n         status: PENDING, checkoutUrl?}\n\nGET /api/v1/subscriptions/{id}\nPOST /api/v1/subscriptions/{id}/cancel\nGET /api/v1/vouchers\n\n401: Unauthorized\n403: Not owner of subscription\n409: Key reused with different payload\n\nInternal RPC:\nrenewSubscription(id, billingPeriod)\nPOST /api/v1/payments/webhook",
			"fontSize": 18,
			"baseFontSize": 18,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "API Design\nREST\nPOST /api/v1/subscription/subscribe\nHeader: Bearer JWT\nIdempotency-Key: <unique key>\nBody: { planId, voucherCode? }\n=> 202 {subscriptionId, paymentId,\n         status: PENDING, checkoutUrl?}\n\nGET /api/v1/subscriptions/{id}\nPOST /api/v1/subscriptions/{id}/cancel\nGET /api/v1/vouchers\n\n401: Unauthorized\n403: Not owner of subscription\n409: Key reused with different payload\n\nInternal RPC:\nrenewSubscription(id, billingPeriod)\nPOST /api/v1/payments/webhook",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
