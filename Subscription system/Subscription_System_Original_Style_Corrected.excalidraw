    {
      "id": "subOrig_LLpBYBfyMboS",
      "type": "text",
      "x": 1155,
      "y": 2045,
      "width": 700,
      "height": 183,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 2086837092,
      "version": 36,
      "versionNonce": 1831912036,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794751554003,
      "created": 1794751520026,
      "link": null,
      "locked": false,
      "text": "Deep Dive / Invariants:\n- 1 logical checkout -> at most 1 provider charge\n- 1 invoice per subscription billing period\n- 1 provider webhook/event may arrive many times\n- status transitions must be legal + idempotent\n- NEVER hold SQL locks while calling PSP\n- failed charge does not extend paid_through\n- cancellations racing with charges need policy",
      "fontSize": 18,
      "baseFontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Deep Dive / Invariants:\n- 1 logical checkout -> at most 1 provider charge\n- 1 invoice per subscription billing period\n- 1 provider webhook/event may arrive many times\n- status transitions must be legal + idempotent\n- NEVER hold SQL locks while calling PSP\n- failed charge does not extend paid_through\n- cancellations racing with charges need policy",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
