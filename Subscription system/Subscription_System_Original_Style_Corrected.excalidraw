			"text": "Subscription\nSystem",
			"fontSize": 21,
			"baseFontSize": 21,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Subscription System",
			"autoResize": false,
