    {
      "id": "-PUomkPD-3j8v0TtJR_JW",
      "type": "text",
      "x": 2100.336578935754,
      "y": 1754.5952928049196,
      "width": 540.15966796875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAQ",
      "roundness": null,
      "seed": 602841828,
      "version": 474,
      "versionNonce": 1752912647,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795014337424,
      "created": 1794735184333,
      "link": null,
      "locked": false,
      "text": "FR:\n1) Buy subscription (call payment)\n2) Auto Renew subscription\n3) Cancel subscription\n4) Voucher for subscription\n5) Check subscription status\n\nNFR:\n1) 99.99% Availability\n2) Strong Consistency, CP \n3) <100MS, check status, <200ms buy subscription p95\n4) Durability\n5) Reliability (No duplicate payment, or subscription)\n\nCore Entities\nPlans\nSubscriptions\nBillings\nPayments\nVouchers",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FR:\n1) Buy subscription (call payment)\n2) Auto Renew subscription\n3) Cancel subscription\n4) Voucher for subscription\n5) Check subscription status\n\nNFR:\n1) 99.99% Availability\n2) Strong Consistency, CP \n3) <100MS, check status, <200ms buy subscription p95\n4) Durability\n5) Reliability (No duplicate payment, or subscription)\n\nCore Entities\nPlans\nSubscriptions\nBillings\nPayments\nVouchers",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CHTJKOpHcMDpeubqshsyG",
      "type": "text",
      "x": 2726.6363537230372,
      "y": 1738.0929481561398,
      "width": 397.2396240234375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAR",
      "roundness": null,
      "seed": 1858343396,
      "version": 399,
      "versionNonce": 1843168489,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795014337424,
      "created": 1794735436344,
      "link": null,
      "locked": false,
      "text": "API Design\nREST\nPOST /api/v1/subscription/subscribe\nHeader : JWT/session\nIdempotency-Key\nBody:{\n    planId,\n    voucherId\n}\n\nGET /api/v1/subscription\nGET /api/v1/vouchers\nPUT /api/v1/subscription/cancel\nHeader:JWT/session\nBody:{subscriptionId}\n\n401 Unauthorized\n201 Success\n\nRPC\nrenewSubscription(subscriptionId,userId)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Design\nREST\nPOST /api/v1/subscription/subscribe\nHeader : JWT/session\nIdempotency-Key\nBody:{\n    planId,\n    voucherId\n}\n\nGET /api/v1/subscription\nGET /api/v1/vouchers\nPUT /api/v1/subscription/cancel\nHeader:JWT/session\nBody:{subscriptionId}\n\n401 Unauthorized\n201 Success\n\nRPC\nrenewSubscription(subscriptionId,userId)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
