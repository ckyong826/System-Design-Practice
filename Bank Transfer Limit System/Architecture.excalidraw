    },
    {
      "id": "CoODmdhqsfZdTF-VZ3KD0",
      "type": "text",
      "x": 3905.674616659374,
      "y": 2270.7229102258016,
      "width": 660.2796020507812,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB8",
      "roundness": null,
      "seed": 1186155876,
      "version": 782,
      "versionNonce": 539799433,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795014337424,
      "created": 1794751231947,
      "link": null,
      "locked": false,
      "text": "Flow 3\nCancel Subscriptoins\n1) Same with FLow 1\nTransaction\n2) Lock subcription\n3) Check condition\n4) UPDATE auto_renew=false\nEND\nreturn success/error\n\nFlow 4\nVoucher\n1) continue from flow 1 10)\n2) Msg Broker will fetch event saved in outbox relay/ or using CDC\n3) Publish event to consumer/workers and update voucher status\n\nFlow 5\nJust query subscription status from db\nif needed we can use DB read replica/ redis cache\nneed to check how many DAU\nif we have likely >5k RPS for checking subscription status\nwe can cache subscription to redis -> fallback to read replica.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flow 3\nCancel Subscriptoins\n1) Same with FLow 1\nTransaction\n2) Lock subcription\n3) Check condition\n4) UPDATE auto_renew=false\nEND\nreturn success/error\n\nFlow 4\nVoucher\n1) continue from flow 1 10)\n2) Msg Broker will fetch event saved in outbox relay/ or using CDC\n3) Publish event to consumer/workers and update voucher status\n\nFlow 5\nJust query subscription status from db\nif needed we can use DB read replica/ redis cache\nneed to check how many DAU\nif we have likely >5k RPS for checking subscription status\nwe can cache subscription to redis -> fallback to read replica.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
