      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "text": "SINGLE REQUEST TRACE TO PRACTICE IN AN INTERVIEW",
      "originalText": "SINGLE REQUEST TRACE TO PRACTICE IN AN INTERVIEW",
      "boundElements": []
    },
    {
      "id": "f118d2b18aee4c8fa4f2",
      "type": "text",
      "x": 3345,
      "y": 2560,
      "width": 2140,
      "height": 72,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1261794120,
      "version": 2,
      "versionNonce": 1234893668,
      "isDeleted": true,
      "updated": 1794665975962,
      "created": 1794648075157,
      "index": "b8q",
      "link": null,
      "locked": false,
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "text": "POST: Client → Gateway → Posts + Outbox (atomic) → Kafka → fan-out policy → FeedEntries / Hot Post Index.\nGET:  Client → Gateway → Feed API → Redis (DB fallback) → merge/dedupe → batch hydrate + visibility → cursor page.",
      "originalText": "POST: Client → Gateway → Posts + Outbox (atomic) → Kafka → fan-out policy → FeedEntries / Hot Post Index.\nGET:  Client → Gateway → Feed API → Redis (DB fallback) → merge/dedupe → batch hydrate + visibility → cursor page.",
      "boundElements": []
    },
