    {
      "id": "6m2AIcUExKMOjIHBVxG3Y",
      "type": "text",
      "x": 1392.5420432731185,
      "y": 2379.5183346136305,
      "width": 76.01991271972656,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
