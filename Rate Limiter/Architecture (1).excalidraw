      "seed": 1055721565,
      "version": 535,
      "versionNonce": 947750236,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794665975961,
      "created": 1794642257286,
      "link": null,
      "locked": false,
      "text": "API DESIGN\n\nPOST /api/v1/posts\nAuth: Bearer JWT\nBody: { content }\n201 Created { post_id }\n400 Invalid request\n401 Unauthorized\n429 Rate limited\n\nPOST /api/v1/follows\nAuth: Bearer JWT\nBody: { following_id }\n201 Created / 200 existing\n400 / 401 / 429\n\nDELETE /api/v1/follows/{id}\n204 No Content\n\nGET /api/v1/feed\n?limit=20&cursor=<opaque>\nAuth: Bearer JWT\n200 { items, next_cursor }\n401 Unauthorized\n429 Rate limited\n\nCursor based on\n(created_at, post_id)\nwith deterministic ordering.\n\nDeleted / unfollowed posts\nmust be filtered on read.",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API DESIGN\n\nPOST /api/v1/posts\nAuth: Bearer JWT\nBody: { content }\n201 Created { post_id }\n400 Invalid request\n401 Unauthorized\n429 Rate limited\n\nPOST /api/v1/follows\nAuth: Bearer JWT\nBody: { following_id }\n201 Created / 200 existing\n400 / 401 / 429\n\nDELETE /api/v1/follows/{id}\n204 No Content\n\nGET /api/v1/feed\n?limit=20&cursor=<opaque>\nAuth: Bearer JWT\n200 { items, next_cursor }\n401 Unauthorized\n429 Rate limited\n\nCursor based on\n(created_at, post_id)\nwith deterministic ordering.\n\nDeleted / unfollowed posts\nmust be filtered on read.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
