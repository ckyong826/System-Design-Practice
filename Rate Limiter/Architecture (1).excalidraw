    {
      "id": "tA1P0uB-JY10HjB-_hSDy",
      "type": "text",
      "x": 764.0156335358386,
      "y": 828.3008292338379,
      "width": 370,
      "height": 890,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iqRXNdub-whBvdO4OtSPZ"
      ],
      "frameId": null,
      "index": "b3t8",
