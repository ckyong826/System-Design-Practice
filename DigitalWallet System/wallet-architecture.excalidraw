      "text": "Optional history replica",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optional history replica",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
