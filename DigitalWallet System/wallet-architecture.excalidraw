    {
      "id": "0rDSsVW1",
      "type": "text",
      "x": 1680,
      "y": 1450,
      "width": 543,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0042",
      "roundness": null,
      "seed": 1143643459,
      "version": 781,
      "versionNonce": 1143645254,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795070903234,
      "created": 1794325419211,
      "link": null,
      "locked": false,
      "text": "Durability + safe failover\nPostgreSQL synchronous_commit = on\n+ configured synchronous standby\n-> Success waits for local + required standby WAL flush\n-> Flush means durable; it does not mean a replica's\n   queries have replayed the transfer yet\n\nPromote only an eligible replica with ALL acknowledged\ncommits; replay them before serving money traffic.\nFence old primary before enabling the new writer.\n-> Never send strict balance reads to a random replica\n-> Pause transfers if sync durability or failover safety\n   cannot be guaranteed; async history may still lag\n-> No generic W+R>N or sloppy-quorum money reads",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Durability + safe failover\nPostgreSQL synchronous_commit = on\n+ configured synchronous standby\n-> Success waits for local + required standby WAL flush\n-> Flush means durable; it does not mean a replica's\n   queries have replayed the transfer yet\n\nPromote only an eligible replica with ALL acknowledged\ncommits; replay them before serving money traffic.\nFence old primary before enabling the new writer.\n-> Never send strict balance reads to a random replica\n-> Pause transfers if sync durability or failover safety\n   cannot be guaranteed; async history may still lag\n-> No generic W+R>N or sloppy-quorum money reads",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "rawText": "Durability + safe failover\nPostgreSQL synchronous_commit = on\n+ configured synchronous standby\n-> Success waits for local + required standby WAL flush\n-> Flush means durable; it does not mean a replica's\n   queries have replayed the transfer yet\n\nPromote only an eligible replica with ALL acknowledged\ncommits; replay them before serving money traffic.\nFence old primary before enabling the new writer.\n-> Never send strict balance reads to a random replica\n-> Pause transfers if sync durability or failover safety\n   cannot be guaranteed; async history may still lag\n-> No generic W+R>N or sloppy-quorum money reads"
    },
