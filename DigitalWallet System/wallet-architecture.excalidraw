  "elements": [
    {
      "id": "TSKlJqyh",
      "type": "text",
      "x": 0,
      "y": 90,
      "width": 484,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1271725677,
      "version": 1417,
      "versionNonce": 1797558822,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795070946132,
      "created": 1794321997362,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n-> Check balance\n-> Transfer money\n-> View transaction history\n\nNon Functional Requirements\n-> Strong consistency for money + fresh balances\n-> History can lag a few seconds\n-> 99.95% monthly availability, correctness first\n-> p95 balance <200ms\n-> p95 completed transfer <500ms\n\nBack of the envelope\n10M registered users, 2M DAU\n2M x 5 transfers/day = 10M/day\n-> 116 average TPS; 1,160 peak at 10x\n2M x 50 combined reads/day = 100M/day\n-> 1,160 average RPS; about 12K peak\n\nStorage (500 bytes/transfer, raw estimate)\n300M/month -> 150GB/month -> 1.8TB/year\n-> Excludes ledger, indexes, WAL, replicas,\n   and backups",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n-> Check balance\n-> Transfer money\n-> View transaction history\n\nNon Functional Requirements\n-> Strong consistency for money + fresh balances\n-> History can lag a few seconds\n-> 99.95% monthly availability, correctness first\n-> p95 balance <200ms\n-> p95 completed transfer <500ms\n\nBack of the envelope\n10M registered users, 2M DAU\n2M x 5 transfers/day = 10M/day\n-> 116 average TPS; 1,160 peak at 10x\n2M x 50 combined reads/day = 100M/day\n-> 1,160 average RPS; about 12K peak\n\nStorage (500 bytes/transfer, raw estimate)\n300M/month -> 150GB/month -> 1.8TB/year\n-> Excludes ledger, indexes, WAL, replicas,\n   and backups",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "rawText": "Functional Requirements\n-> Check balance\n-> Transfer money\n-> View transaction history\n\nNon Functional Requirements\n-> Strong consistency for money + fresh balances\n-> History can lag a few seconds\n-> 99.95% monthly availability, correctness first\n-> p95 balance <200ms\n-> p95 completed transfer <500ms\n\nBack of the envelope\n10M registered users, 2M DAU\n2M x 5 transfers/day = 10M/day\n-> 116 average TPS; 1,160 peak at 10x\n2M x 50 combined reads/day = 100M/day\n-> 1,160 average RPS; about 12K peak\n\nStorage (500 bytes/transfer, raw estimate)\n300M/month -> 150GB/month -> 1.8TB/year\n-> Excludes ledger, indexes, WAL, replicas,\n   and backups"
    },
