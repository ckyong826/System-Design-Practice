			"created": 1794323666879,
			"link": null,
			"locked": false,
			"text": "Idempotency key\nWhat if both key arrived at same time?\n-> add a unique constraint, save key in same transaction\nWhat if different payload?\n-> Reject the new operation ",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Idempotency key\nWhat if both key arrived at same time?\n-> add a unique constraint, save key in same transaction\nWhat if different payload?\n-> Reject the new operation ",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
