		{
			"id": "0rDSsVW1",
			"type": "text",
			"x": 1104.181624227338,
			"y": 1654.774735833047,
			"width": 800,
			"height": 450,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "ak",
			"roundness": null,
			"seed": 1143643459,
			"version": 780,
			"versionNonce": 1691674829,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794329573841,
			"created": 1794325419211,
			"link": null,
			"locked": false,
			"text": "Quorum\nW+R>N\nonly commit after W number of replica are updated\n-> make sure eventual consistency\n\nSloppy Quorum\n-> reach available service first for failover\n\n3 nodes setup what if read replica down?\n-> send transfer and balances checks to primary and healthy replicas\n\nFencing the old or down primary before elected the new primary\n\nRequire transfer's log record to the synchronous replica and promote the\nreplica with all those record and replay them before serving traffic.\n\nAsynchronous replication is not suitable here since ack transfers can be lost\nduring failover.",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Quorum\nW+R>N\nonly commit after W number of replica are updated\n-> make sure eventual consistency\n\nSloppy Quorum\n-> reach available service first for failover\n\n3 nodes setup what if read replica down?\n-> send transfer and balances checks to primary and healthy replicas\n\nFencing the old or down primary before elected the new primary\n\nRequire transfer's log record to the synchronous replica and promote the\nreplica with all those record and replay them before serving traffic.\n\nAsynchronous replication is not suitable here since ack transfers can be lost\nduring failover.",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
