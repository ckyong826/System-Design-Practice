{
	"type": "excalidraw",
	"version": 2,
	"source": "https://github.com/zsviczian/obsidian-excalidraw-plugin/releases/tag/2.27.3",
	"elements": [
		{
			"id": "TSKlJqyh",
			"type": "text",
			"x": -368.73543025197074,
			"y": 873.6085436943811,
			"width": 800,
			"height": 1250,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a1",
			"roundness": null,
			"seed": 1271725677,
			"version": 1415,
			"versionNonce": 158493059,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794324915906,
			"created": 1794321997362,
			"link": null,
			"locked": false,
			"text": "Digital Wallet (Millions of user)\n\nFunctional Requirement\n-> Check balances\n-> transfer money\n-> View Transaction\n\nNon Functional Requirment\n-> Strong consistency(money movement)\n-> Eventual Consistency(transaction history)\n-> 99.95% Month Availability\n-> 10M users, 2M DAU \n-> 10M Daily avg transaction -> /86400 -> 116tps\n-> 116x10 -> 1160 tps on peak hour\n-> 1k RPS on read path and 10k peak\n-> p95<200ms = read path, p95 <500ms = write path\n\nEnvelop of back of calculation\n10M transaction -> 300M month transaction -> 150GB per month\n-> 1.8 TB storage\n\nDB Design\nBalance Table\n - current_balance NUMERIC\n - available_balance NUMERIC\n - user_id INDEX\n - balance_id  \nWhat if negative value?\n-> balance NOT NULL CHECK(balance>=0)\n\nLedger Table\n- credit_user\n- credit_money\n- debit_user\n- debit_money\n- transaction_id\n\nTransaction Table\n- sender_id INDEX\n- receiver_id INDEX\n- amount NUMERIC NOT NULL CHECK(balance>=0)\n- created_at INDEX\n- updated_at\n- txid \n- action VARCHAR\n\nCOMPOSITE INDEX(sender_id, created_at ) , COMPOSITE INDEX(receiver_id,\ncreated_at )\n\nPagination -> Cursor ",
			"fontSize": 20,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Digital Wallet (Millions of user)\n\nFunctional Requirement\n-> Check balances\n-> transfer money\n-> View Transaction\n\nNon Functional Requirment\n-> Strong consistency(money movement)\n-> Eventual Consistency(transaction history)\n-> 99.95% Month Availability\n-> 10M users, 2M DAU \n-> 10M Daily avg transaction -> /86400 -> 116tps\n-> 116x10 -> 1160 tps on peak hour\n-> 1k RPS on read path and 10k peak\n-> p95<200ms = read path, p95 <500ms = write path\n\nEnvelop of back of calculation\n10M transaction -> 300M month transaction -> 150GB per month\n-> 1.8 TB storage\n\nDB Design\nBalance Table\n - current_balance NUMERIC\n - available_balance NUMERIC\n - user_id INDEX\n - balance_id  \nWhat if negative value?\n-> balance NOT NULL CHECK(balance>=0)\n\nLedger Table\n- credit_user\n- credit_money\n- debit_user\n- debit_money\n- transaction_id\n\nTransaction Table\n- sender_id INDEX\n- receiver_id INDEX\n- amount NUMERIC NOT NULL CHECK(balance>=0)\n- created_at INDEX\n- updated_at\n- txid \n- action VARCHAR\n\nCOMPOSITE INDEX(sender_id, created_at ) , COMPOSITE INDEX(receiver_id,\ncreated_at )\n\nPagination -> Cursor ",
			"autoResize": false,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
