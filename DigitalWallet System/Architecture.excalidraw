		{
			"id": "7OOitVGU",
			"type": "text",
			"x": 1241.3273078563625,
			"y": 1479.4927542703626,
			"width": 120.068359375,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
