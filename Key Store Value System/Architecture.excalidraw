			"frameId": null,
			"index": "b12",
			"roundness": null,
			"seed": 51683979,
			"version": 243,
			"versionNonce": 1188710755,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794639924996,
			"link": null,
			"locked": false,
			"text": "Core data model\nKey -> value + version\nTTL / expiresAt; tombstone",
			"fontSize": 22,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Core data model\nKey -> value + version\nTTL / expiresAt; tombstone",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "RcfPr77Q",
			"type": "text",
			"x": 579.9126870977606,
			"y": 589.3543049210954,
			"width": 428.92132568359375,
			"height": 230.625,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"vICHfYqas-dIIiCQQWXzx",
				"gkPEVRyI-guK07dQWmybv"
			],
			"frameId": null,
			"index": "b13",
			"roundness": null,
			"seed": 284627909,
			"version": 408,
			"versionNonce": 1260469322,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794639998136,
			"link": null,
			"locked": false,
			"text": "External API (HTTP or gRPC)\nGET(key) -> value, version, ttl | 404\nPUT(key, value, ttl?, ifVersion?)\nDELETE(key, ifVersion?)\n\nInternal RPC (between storage nodes)\n- Coordinator selects replicas via hash ring\n- Parallel reads/writes; retry semantics\n- Binary serialization may reduce overhead",
			"fontSize": 20.5,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "External API (HTTP or gRPC)\nGET(key) -> value, version, ttl | 404\nPUT(key, value, ttl?, ifVersion?)\nDELETE(key, ifVersion?)\n\nInternal RPC (between storage nodes)\n- Coordinator selects replicas via hash ring\n- Parallel reads/writes; retry semantics\n- Binary serialization may reduce overhead",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
