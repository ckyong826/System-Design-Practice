			"link": null,
			"locked": false,
			"text": "Latency budget (illustrative, NOT measured)",
			"fontSize": 27,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Latency budget (illustrative, NOT measured)",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "MV5SVLBf",
			"type": "text",
			"x": 124,
			"y": 2550,
			"width": 455.83160400390625,
			"height": 312,
			"angle": 0,
			"strokeColor": "#1e293b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c02cO",
			"roundness": null,
			"seed": 753178737,
			"version": 1,
			"versionNonce": 2023910043,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794648190079,
			"link": null,
			"locked": false,
			"text": "Scope: same-region GET p99 at target load.\n  1 ms  Gateway + key routing\n  3 ms  Parallel replica RPC (wait for R=2)\n  2 ms  Local storage lookup / cache\n  1 ms  Response serialization + return\n  3 ms  Margin for queueing / jitter\n  -------\n 10 ms  Illustrative TOTAL budget\n\nDo not simply sum component p99s: they\nare correlated and request paths overlap.\nPUT may need a separate SLO due to fsync.",
			"fontSize": 20.8,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Scope: same-region GET p99 at target load.\n  1 ms  Gateway + key routing\n  3 ms  Parallel replica RPC (wait for R=2)\n  2 ms  Local storage lookup / cache\n  1 ms  Response serialization + return\n  3 ms  Margin for queueing / jitter\n  -------\n 10 ms  Illustrative TOTAL budget\n\nDo not simply sum component p99s: they\nare correlated and request paths overlap.\nPUT may need a separate SLO due to fsync.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "e6KRKSCd",
			"type": "text",
