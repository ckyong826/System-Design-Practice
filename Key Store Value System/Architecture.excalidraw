		{
			"id": "88OFeBkc",
			"type": "text",
			"x": 383.8286397057756,
			"y": 1323.600226727934,
			"width": 245.30355834960938,
			"height": 67.04689439197544,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
