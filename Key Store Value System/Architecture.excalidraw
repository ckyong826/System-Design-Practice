		},
		{
			"id": "HxF3tdLO",
			"type": "text",
			"x": 1420,
			"y": 2065,
			"width": 378.8482666015625,
			"height": 238.75,
			"angle": 0,
			"strokeColor": "#1e293b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c02cJ",
			"roundness": null,
			"seed": 1916776175,
			"version": 1,
			"versionNonce": 186241381,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794648190079,
			"link": null,
			"locked": false,
			"text": "1. Write a tombstone for key k.\n2. Replicate using the same W=2 quorum.\n3. GET treats the winning tombstone\n   as logically deleted (not found).\n4. Compaction eventually reclaims\n   obsolete data safely.\nTTL is logical expiration; use clear\nrules for stale replicas and clocks.\nConditional deletion may use a version\ncheck to avoid overwriting new data.",
			"fontSize": 19.1,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Write a tombstone for key k.\n2. Replicate using the same W=2 quorum.\n3. GET treats the winning tombstone\n   as logically deleted (not found).\n4. Compaction eventually reclaims\n   obsolete data safely.\nTTL is logical expiration; use clear\nrules for stale replicas and clocks.\nConditional deletion may use a version\ncheck to avoid overwriting new data.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
