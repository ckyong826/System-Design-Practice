		{
			"id": "jMahBSAb",
			"type": "text",
			"x": 118,
			"y": 2065,
			"width": 368.82080078125,
			"height": 238.75,
			"angle": 0,
			"strokeColor": "#1e293b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c02cD",
			"roundness": null,
			"seed": 363422642,
			"version": 2,
			"versionNonce": 1227929893,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794648190079,
			"link": null,
			"locked": false,
			"text": "1. Client sends PUT(k, v, ttl?).\n2. Coordinator hashes k to replica set.\n3. Send write to A, B, C in parallel.\n4. Each replica appends WAL, then\n   updates memtable; ACK only when\n   chosen WAL durability rule is met.\n5. Return success on W=2 valid ACKs.\n6. Remaining replica catches up later.\nFailure: <W ACKs => timeout/error.\nRetries need idempotency/version rules.",
			"fontSize": 19.1,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Client sends PUT(k, v, ttl?).\n2. Coordinator hashes k to replica set.\n3. Send write to A, B, C in parallel.\n4. Each replica appends WAL, then\n   updates memtable; ACK only when\n   chosen WAL durability rule is met.\n5. Return success on W=2 valid ACKs.\n6. Remaining replica catches up later.\nFailure: <W ACKs => timeout/error.\nRetries need idempotency/version rules.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
