			],
			"frameId": null,
			"index": "b26",
			"roundness": null,
			"seed": 1040740659,
			"version": 295,
			"versionNonce": 1589328495,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794640673880,
			"link": null,
			"locked": false,
			"text": "Compaction\n- Merge immutable SSTables in background.\n- Drop old versions/tombstones ONLY when safe.\n- Trade write amplification for faster reads.",
			"fontSize": 19.3,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Compaction\n- Merge immutable SSTables in background.\n- Drop old versions/tombstones ONLY when safe.\n- Trade write amplification for faster reads.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "gfms6ORH",
			"type": "text",
			"x": 598,
			"y": 1760,
			"width": 551.69384765625,
			"height": 120.625,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dotted",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"Y_bcz2EXrVUMsxwDMP9yf"
			],
			"frameId": null,
			"index": "b27",
			"roundness": null,
			"seed": 958000499,
			"version": 349,
			"versionNonce": 330288607,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794640721075,
			"link": null,
			"locked": false,
			"text": "Bloom filter\n- Negative => key definitely absent in this SSTable.\n- Positive => possible match (false positives).\n- Avoid unnecessary SSTable/disk lookups.\n- Does not replace a real key comparison.",
			"fontSize": 19.3,
			"baseFontSize": null,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Bloom filter\n- Negative => key definitely absent in this SSTable.\n- Positive => possible match (false positives).\n- Avoid unnecessary SSTable/disk lookups.\n- Does not replace a real key comparison.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "453QMQef",
			"type": "text",
			"x": 1143,
			"y": 552,
			"width": 489.85186767578125,
			"height": 41.25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dotted",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b28",
			"roundness": null,
			"seed": 465521235,
			"version": 213,
			"versionNonce": 1641693922,
