			"rawText": ""
		},
		{
			"id": "clq6beVi",
			"type": "text",
			"x": 769,
			"y": 2065,
			"width": 427.400390625,
			"height": 238.75,
			"angle": 0,
			"strokeColor": "#1e293b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "c02cG",
			"roundness": null,
			"seed": 1643426706,
			"version": 1,
			"versionNonce": 1977824013,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1794648190079,
			"created": 1794648190079,
			"link": null,
			"locked": false,
			"text": "1. Client sends GET(k).\n2. Coordinator locates replicas.\n3. Query replicas in parallel.\n4. Wait for R=2 valid responses.\n5. Reconcile versions and tombstones;\n   return value or not found.\n6. Trigger read repair when replicas\n   disagree (implementation-dependent).\nIf A failed after A+B ACKed, B+C\ncan read the write under stated assumptions.",
			"fontSize": 19.1,
			"baseFontSize": null,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Client sends GET(k).\n2. Coordinator locates replicas.\n3. Query replicas in parallel.\n4. Wait for R=2 valid responses.\n5. Reconcile versions and tombstones;\n   return value or not found.\n6. Trigger read repair when replicas\n   disagree (implementation-dependent).\nIf A failed after A+B ACKed, B+C\ncan read the write under stated assumptions.",
			"autoResize": true,
			"lineHeight": 1.25,
			"labelPosition": null,
			"hasTextLink": false,
			"rawText": ""
		},
