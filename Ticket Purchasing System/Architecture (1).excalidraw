    {
      "id": "mUVSc9x_S5cD2W5Lqi-ue",
      "type": "text",
      "x": 21.268380335011557,
      "y": 992.0299771233465,
      "width": 198.85984802246094,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1747712323,
      "version": 641,
      "versionNonce": 1625704717,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794411570512,
      "created": 1794411208566,
      "link": null,
      "locked": false,
      "text": "DB & API Design\nConcert Table\n-> concert_id\n\nSeat Table\n-> concert_id\n-> seat_id\n-> holder_id\n-> status\n\nBooking Table\n-> booking_id\n-> user_id\n-> seat_id\n-> concert_id\n-> created_at\n-> idemp_key\n-> payment_id\n-> status -> \"init\"\n\nPayment Table\n-> payment_gateway\n-> amount \n-> ref_no\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DB & API Design\nConcert Table\n-> concert_id\n\nSeat Table\n-> concert_id\n-> seat_id\n-> holder_id\n-> status\n\nBooking Table\n-> booking_id\n-> user_id\n-> seat_id\n-> concert_id\n-> created_at\n-> idemp_key\n-> payment_id\n-> status -> \"init\"\n\nPayment Table\n-> payment_gateway\n-> amount \n-> ref_no\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WSj8r1fFNyqmGQdR7zbnd",
      "type": "text",
      "x": 222.85090331960515,
      "y": 1029.0391955475059,
      "width": 312.519775390625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0k",
      "roundness": null,
      "seed": 2012258125,
      "version": 94,
      "versionNonce": 1439020237,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794411504210,
      "created": 1794411488377,
      "link": null,
      "locked": false,
      "text": "API design\nGET /concert\nGET /concert/:ID\nPOST /booking/init init booking\nPOST /booking/:ID/checkout\nGET /booking/:ID",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API design\nGET /concert\nGET /concert/:ID\nPOST /booking/init init booking\nPOST /booking/:ID/checkout\nGET /booking/:ID",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VDP6C8YXdr1aldhlzbUPS",
      "type": "text",
      "x": 740.0434897034501,
      "y": 694.0336429868453,
      "width": 672.239501953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0l",
      "roundness": null,
      "seed": 569825933,
      "version": 485,
      "versionNonce": 678640108,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794557795429,
      "created": 1794412281555,
      "link": null,
      "locked": false,
      "text": "Deep Dive 1\nPing Pong to always update the seat availability\nUpdate Cache after update seat status in db\nwhat if client still show available for HOLD seat?\n-> init request will check is the seat reserved\nWhy not websocket?\n-> uses open network connection, memory and occasional heartbeats \n-> consume too much resources\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep Dive 1\nPing Pong to always update the seat availability\nUpdate Cache after update seat status in db\nwhat if client still show available for HOLD seat?\n-> init request will check is the seat reserved\nWhy not websocket?\n-> uses open network connection, memory and occasional heartbeats \n-> consume too much resources\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "369ZVg3kAIE-VVGcxfKMv",
      "type": "text",
      "x": 1034.0450263857188,
