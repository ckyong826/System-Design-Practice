      "locked": false,
      "text": "Deep Dive : Data Inconsistency\nWhat if db commits but service crash\n-> seat availability cache is not updated\n-> transactional outbox\n-> save a seat changed event\n-> worker refresh cache & retries on failure\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep Dive : Data Inconsistency\nWhat if db commits but service crash\n-> seat availability cache is not updated\n-> transactional outbox\n-> save a seat changed event\n-> worker refresh cache & retries on failure\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
